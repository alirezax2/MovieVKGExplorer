# ==============================================================================
# PostgreSQL & Metabase Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting Docker Compose:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit your actual '.env' file containing real secrets to version control.
# - Choose strong, unique passwords for production deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Service Settings
# ------------------------------------------------------------------------------
# Database name to initialize upon container first run
POSTGRES_DB=movies_db

# Superuser / Primary administrative username
POSTGRES_USER=movie_admin

# Superuser / Primary administrative password (CHANGE THIS FOR PRODUCTION)
POSTGRES_PASSWORD=dev_movie_master_secret_password_2026

# Host port mapping for PostgreSQL (Default: 5425)
POSTGRES_PORT=5425

# ------------------------------------------------------------------------------
# Metabase Service Settings
# ------------------------------------------------------------------------------
# Host port mapping for Metabase Web UI (Default: 3000)
METABASE_PORT=3000

# ------------------------------------------------------------------------------
# System & Localization
# ------------------------------------------------------------------------------
# Standard timezone across all containers
TZ=UTC
