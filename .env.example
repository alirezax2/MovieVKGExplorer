# ==============================================================================
# Movie Virtual Knowledge Graph (VKG) - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running the application:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (Read-Only User for VKG & App Queries)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5425
POSTGRES_DB=movies_db
POSTGRES_USER=ontop_ro
POSTGRES_PASSWORD=dev_ontop_ro_secret_password_2026

# ------------------------------------------------------------------------------
# Ontop Virtual Knowledge Graph Service
# ------------------------------------------------------------------------------
ONTOP_PORT=8825
ONTOP_ENDPOINT_URL=http://localhost:8825/sparql
VKG_BASE_IRI=https://example.org/movie-vkg/

# ------------------------------------------------------------------------------
# OmniRoute LLM Gateway Configuration
# ------------------------------------------------------------------------------
OMNIROUTE_BASE_URL=https://omniroute.alphigma.com/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=no-think/antigravity/claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# FastAPI Application Security & Runtime
# ------------------------------------------------------------------------------
API_KEY=dev_movie_vkg_secret_api_key_2026
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8025
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5125,http://localhost:8025,http://127.0.0.1:5125,http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173
MAX_SPARQL_RESULTS=500
QUERY_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=60
